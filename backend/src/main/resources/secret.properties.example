# Template for local development. Copy to secret.properties (gitignored) and fill
# in real values. Never commit the filled-in copy.
#
# None of these has a default in application.properties — the app will refuse to
# start until all three are set, either here or as environment variables.

# Supabase database password (Supabase dashboard -> Project Settings -> Database).
DB_PASSWORD=

# HMAC signing key for JWTs. Must be at least 32 bytes; generate with:
#   openssl rand -base64 48
# Changing this invalidates every issued token, logging all users out.
JWT_SECRET=

# Password for the bootstrap admin account. Only used the first time the admin
# user is created; it does not update an existing admin account.
ADMIN_PASSWORD=
